# Light Sync's settings on the laptop (start_lights.bat sets these; on the Pi the add-on's options do).
# Secrets (the Home Assistant token, the camera password, an optional Claude API key) go in secrets.yaml,
# see secrets.example.yaml. Never commit secrets.yaml or .env.

HA_URL=http://192.168.1.10:8123

# cameras (motionEye streams): the TV camera (screen colours) and the room camera (presence)
SNAPSHOT_URL=http://192.168.1.10:8082/
ROOM_CAM_URL=http://192.168.1.10:8081/
SNAP_USER=your-motioneye-stream-user

# the lights: Home Assistant entities and their Govee LAN device ids
LIGHT_SCREEN=light.tv_strip
LIGHT_BEAT=light.corner_bulb
LIGHT_WASH=light.top_bulb
GOVEE_SCREEN=02:00:00:00:00:00:00:01
GOVEE_BEAT=02:00:00:00:00:00:00:02
GOVEE_WASH=02:00:00:00:00:00:00:03
SCREEN_SEGMENTS=10
SCREEN_SEGMENTS_FROM_RIGHT=1

HA_MEDIA=media_player.tv_box
SENSITIVITY=1.4
AMBIENT_BRIGHT=150
